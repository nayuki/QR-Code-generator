(module
  ;; No imports, allocator, WASI, or start function. Each instance owns its state.
  ;; Memory map (byte offsets):
  ;;   0..327: ECC tables; 336..380: alphanumeric alphabet
  ;;   1024..32352: modules; 32768..64096: function-module flags
  ;;   65536..69631: data; 69632..73727: interleaved data/ECC
  ;;   73728..73757: RS divisor; 73760..73789: RS remainder
  ;;   73800..73827: penalty run history; 73840..73867: alignment positions
  ;;   73872..73887: internal segment; 77824..81919: internal segment bits
  ;;   131072..524287: caller-owned input, output of segment factories, descriptors
  (memory (export "memory") 8 8)
  (global $size (mut i32) (i32.const 0))
  (global $version (mut i32) (i32.const 0))
  (global $ecl (mut i32) (i32.const -1))
  (global $mask (mut i32) (i32.const -1))

  ;; Tables indexed by ecl * 41 + version (entry zero is unused).
  (data (i32.const 0)
    "\ff\07\0a\0f\14\1a\12\14\18\1e\12\14\18\1a\1e\16\18\1c\1e\1c\1c\1c\1c\1e\1e\1a\1c\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e"
    "\ff\0a\10\1a\12\18\10\12\16\16\1a\1e\16\16\18\18\1c\1c\1a\1a\1a\1a\1c\1c\1c\1c\1c\1c\1c\1c\1c\1c\1c\1c\1c\1c\1c\1c\1c\1c\1c"
    "\ff\0d\16\12\1a\12\18\12\16\14\18\1c\1a\18\14\1e\18\1c\1c\1a\1e\1c\1e\1e\1e\1e\1c\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e"
    "\ff\11\1c\16\10\16\1c\1a\1a\18\1c\18\1c\16\18\18\1e\1c\1c\1a\1c\1e\18\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e\1e")
  (data (i32.const 164)
    "\ff\01\01\01\01\01\02\02\02\02\04\04\04\04\04\06\06\06\06\07\08\08\09\09\0a\0c\0c\0c\0d\0e\0f\10\11\12\13\13\14\15\16\18\19"
    "\ff\01\01\01\02\02\04\04\04\05\05\05\08\09\09\0a\0a\0b\0d\0e\10\11\11\12\14\15\17\19\1a\1c\1d\1f\21\23\25\26\28\2b\2d\2f\31"
    "\ff\01\01\02\02\04\04\06\06\08\08\08\0a\0c\10\0c\11\10\12\15\14\17\17\19\1b\1d\22\22\23\26\28\2b\2d\30\33\35\38\3b\3e\41\44"
    "\ff\01\01\02\04\04\04\05\06\08\08\0b\0b\10\10\12\10\13\15\19\19\19\22\1e\20\23\25\28\2a\2d\30\33\36\39\3c\3f\42\46\4a\4d\51")
  (data (i32.const 336) "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ $%*+-./:")

  ;; Public result accessors. A failed encode invalidates all metadata.
  (func (export "get_input_ptr") (result i32) (i32.const 131072))
  (func (export "get_input_capacity") (result i32) (i32.const 393216))
  (func (export "get_modules_ptr") (result i32) (i32.const 1024))
  (func (export "get_size") (result i32) (global.get $size))
  (func (export "get_version") (result i32) (global.get $version))
  (func (export "get_error_correction_level") (result i32) (global.get $ecl))
  (func (export "get_mask") (result i32) (global.get $mask))
  (func $get_module (export "get_module") (param $x i32) (param $y i32) (result i32)
    (if (i32.or (i32.ge_u (local.get $x) (global.get $size))
                (i32.ge_u (local.get $y) (global.get $size)))
      (then (return (i32.const 0))))
    (i32.load8_u (i32.add (i32.const 1024)
      (i32.add (i32.mul (local.get $y) (global.get $size)) (local.get $x)))))

  (func $reset
    (global.set $size (i32.const 0))
    (global.set $version (i32.const 0))
    (global.set $ecl (i32.const -1))
    (global.set $mask (i32.const -1)))
  (func $valid_range (param $ptr i32) (param $len i32) (result i32)
    ;; Subtraction avoids pointer+length wraparound. Empty ranges may use null,
    ;; but must still have an in-memory pointer for zero-length bulk operations.
    (i32.and (i32.and (i32.or (i32.eqz (local.get $len))
      (i32.ge_u (local.get $ptr) (i32.const 131072)))
      (i32.le_u (local.get $ptr) (i32.const 524288)))
      (i32.le_u (local.get $len) (i32.sub (i32.const 524288) (local.get $ptr)))))
  (func $abs (param $n i32) (result i32)
    (select (i32.sub (i32.const 0) (local.get $n)) (local.get $n)
      (i32.lt_s (local.get $n) (i32.const 0))))
  (func $bit (param $n i32) (param $i i32) (result i32)
    (i32.and (i32.shr_u (local.get $n) (local.get $i)) (i32.const 1)))
  (func $alpha_value (param $c i32) (result i32) (local $i i32)
    (loop $scan
      (if (i32.eq (i32.load8_u (i32.add (i32.const 336) (local.get $i))) (local.get $c))
        (then (return (local.get $i))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $scan (i32.lt_u (local.get $i) (i32.const 45))))
    (i32.const -1))

  ;; Append bits MSB first into a cleared byte array, returning the new bit length.
  (func $append (param $ptr i32) (param $pos i32) (param $val i32) (param $n i32)
    (result i32) (local $addr i32)
    (block $done (loop $bits
      (br_if $done (i32.eqz (local.get $n)))
      (local.set $n (i32.sub (local.get $n) (i32.const 1)))
      (local.set $addr (i32.add (local.get $ptr) (i32.shr_u (local.get $pos) (i32.const 3))))
      (i32.store8 (local.get $addr) (i32.or (i32.load8_u (local.get $addr))
        (i32.shl (call $bit (local.get $val) (local.get $n))
          (i32.sub (i32.const 7) (i32.and (local.get $pos) (i32.const 7))))))
      (local.set $pos (i32.add (local.get $pos) (i32.const 1)))
      (br $bits)))
    (local.get $pos))
  (func $segment_bits (param $mode i32) (param $n i32) (result i32) (local $bits i32)
    (if (i32.gt_u (local.get $n) (i32.const 32767)) (then (return (i32.const -2))))
    (if (i32.eq (local.get $mode) (i32.const 1))
      (then (local.set $bits (i32.div_u (i32.add (i32.mul (local.get $n) (i32.const 10)) (i32.const 2)) (i32.const 3))))
      (else (if (i32.eq (local.get $mode) (i32.const 2))
        (then (local.set $bits (i32.div_u (i32.add (i32.mul (local.get $n) (i32.const 11)) (i32.const 1)) (i32.const 2))))
        (else (if (i32.eq (local.get $mode) (i32.const 4))
          (then (local.set $bits (i32.mul (local.get $n) (i32.const 8))))
          (else (if (i32.eq (local.get $mode) (i32.const 8))
            (then (local.set $bits (i32.mul (local.get $n) (i32.const 13))))
            (else (return (i32.const -2))))))))))
    (if (i32.gt_u (local.get $bits) (i32.const 32767)) (then (return (i32.const -1))))
    (local.get $bits))
  (func $count_bits (param $mode i32) (param $ver i32) (result i32) (local $group i32)
    (local.set $group (i32.div_u (i32.add (local.get $ver) (i32.const 7)) (i32.const 17)))
    (if (i32.eq (local.get $mode) (i32.const 1))
      (then (return (i32.add (i32.const 10) (i32.mul (local.get $group) (i32.const 2))))))
    (if (i32.eq (local.get $mode) (i32.const 2))
      (then (return (i32.add (i32.const 9) (i32.mul (local.get $group) (i32.const 2))))))
    (if (i32.eq (local.get $mode) (i32.const 4))
      (then (return (select (i32.const 8) (i32.const 16) (i32.eqz (local.get $group))))))
    (if (i32.eq (local.get $mode) (i32.const 8))
      (then (return (i32.add (i32.const 8) (i32.mul (local.get $group) (i32.const 2))))))
    (i32.const 0))

  ;; Build a numeric, alphanumeric, byte, or Kanji segment. Kanji input is pairs
  ;; of Shift JIS bytes in the QR ranges. Output and input must not overlap.
  ;; Public factory returns bit length, -1 for excessive length, -2 for invalid input.
  (func $make_segment (export "make_segment")
    (param $mode i32) (param $src i32) (param $len i32) (param $out i32) (param $cap i32)
    (result i32) (local $bits i32) (local $bytes i32)
    (if (i32.eqz (call $valid_range (local.get $src) (local.get $len)))
      (then (return (i32.const -2))))
    (local.set $bits (call $segment_bits (local.get $mode)
      (select (i32.shr_u (local.get $len) (i32.const 1)) (local.get $len)
        (i32.eq (local.get $mode) (i32.const 8)))))
    (if (i32.lt_s (local.get $bits) (i32.const 0)) (then (return (local.get $bits))))
    (local.set $bytes (i32.shr_u (i32.add (local.get $bits) (i32.const 7)) (i32.const 3)))
    (if (i32.or (i32.gt_u (local.get $bytes) (local.get $cap))
      (i32.eqz (call $valid_range (local.get $out) (local.get $bytes))))
      (then (return (i32.const -2))))
    (if (i32.and (i32.and (i32.ne (local.get $len) (i32.const 0)) (i32.ne (local.get $bytes) (i32.const 0)))
      (i32.and (i32.lt_u (local.get $out) (i32.add (local.get $src) (local.get $len)))
               (i32.lt_u (local.get $src) (i32.add (local.get $out) (local.get $bytes)))))
      (then (return (i32.const -2))))
    (call $make_segment_internal (local.get $mode) (local.get $src) (local.get $len) (local.get $out)))
  (func $make_segment_internal (param $mode i32) (param $src i32) (param $len i32) (param $out i32)
    (result i32) (local $i i32) (local $pos i32) (local $value i32)
    (local $accum i32) (local $count i32) (local $group i32) (local $radix i32) (local $bits i32)
    (local.set $bits (call $segment_bits (local.get $mode)
      (select (i32.shr_u (local.get $len) (i32.const 1)) (local.get $len)
        (i32.eq (local.get $mode) (i32.const 8)))))
    (if (i32.lt_s (local.get $bits) (i32.const 0)) (then (return (local.get $bits))))
    (memory.fill (local.get $out) (i32.const 0)
      (i32.shr_u (i32.add (local.get $bits) (i32.const 7)) (i32.const 3)))
    (if (i32.eq (local.get $mode) (i32.const 4))
      (then (memory.copy (local.get $out) (local.get $src) (local.get $len))
        (return (local.get $bits))))
    (if (i32.eq (local.get $mode) (i32.const 8))
      (then
        (if (i32.and (local.get $len) (i32.const 1)) (then (return (i32.const -2))))
        (block $end_kanji (loop $kanji
          (br_if $end_kanji (i32.ge_u (local.get $i) (local.get $len)))
          (local.set $value (i32.or
            (i32.shl (i32.load8_u (i32.add (local.get $src) (local.get $i))) (i32.const 8))
            (i32.load8_u offset=1 (i32.add (local.get $src) (local.get $i)))))
          (local.set $accum (i32.and (local.get $value) (i32.const 255)))
          (if (i32.or (i32.or (i32.lt_u (local.get $accum) (i32.const 0x40))
                             (i32.gt_u (local.get $accum) (i32.const 0xFC)))
                       (i32.eq (local.get $accum) (i32.const 0x7F)))
            (then (return (i32.const -2))))
          (if (i32.and (i32.ge_u (local.get $value) (i32.const 0x8140))
                       (i32.le_u (local.get $value) (i32.const 0x9FFC)))
            (then (local.set $value (i32.sub (local.get $value) (i32.const 0x8140))))
            (else (if (i32.and (i32.ge_u (local.get $value) (i32.const 0xE040))
                               (i32.le_u (local.get $value) (i32.const 0xEBBF)))
              (then (local.set $value (i32.sub (local.get $value) (i32.const 0xC140))))
              (else (return (i32.const -2))))))
          (local.set $value (i32.add (i32.mul (i32.shr_u (local.get $value) (i32.const 8)) (i32.const 192))
            (i32.and (local.get $value) (i32.const 255))))
          (local.set $pos (call $append (local.get $out) (local.get $pos) (local.get $value) (i32.const 13)))
          (local.set $i (i32.add (local.get $i) (i32.const 2)))
          (br $kanji)))
        (return (local.get $bits))))
    (local.set $group (select (i32.const 3) (i32.const 2) (i32.eq (local.get $mode) (i32.const 1))))
    (local.set $radix (select (i32.const 10) (i32.const 45) (i32.eq (local.get $mode) (i32.const 1))))
    (block $done (loop $chars
      (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
      (local.set $value (i32.load8_u (i32.add (local.get $src) (local.get $i))))
      (if (i32.eq (local.get $mode) (i32.const 1))
        (then (local.set $value (i32.sub (local.get $value) (i32.const 48)))
          (if (i32.gt_u (local.get $value) (i32.const 9)) (then (return (i32.const -2)))))
        (else (local.set $value (call $alpha_value (local.get $value)))
          (if (i32.lt_s (local.get $value) (i32.const 0)) (then (return (i32.const -2))))))
      (local.set $accum (i32.add (i32.mul (local.get $accum) (local.get $radix)) (local.get $value)))
      (local.set $count (i32.add (local.get $count) (i32.const 1)))
      (if (i32.eq (local.get $count) (local.get $group))
        (then
          (local.set $pos (call $append (local.get $out) (local.get $pos) (local.get $accum)
            (select (i32.const 10) (i32.const 11) (i32.eq (local.get $mode) (i32.const 1)))))
          (local.set $accum (i32.const 0)) (local.set $count (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $chars)))
    (if (local.get $count)
      (then (drop (call $append (local.get $out) (local.get $pos) (local.get $accum)
        (select (i32.add (i32.mul (local.get $count) (i32.const 3)) (i32.const 1))
          (i32.const 6) (i32.eq (local.get $mode) (i32.const 1)))))))
    (local.get $bits))
  (func (export "make_eci") (param $assignment i32) (param $out i32) (param $cap i32)
    (result i32) (local $n i32) (local $value i32)
    (if (i32.ge_u (local.get $assignment) (i32.const 1000000)) (then (return (i32.const -2))))
    (local.set $n (i32.const 8)) (local.set $value (local.get $assignment))
    (if (i32.ge_u (local.get $assignment) (i32.const 128))
      (then (local.set $n (i32.const 16))
        (local.set $value (i32.or (local.get $assignment) (i32.const 0x8000)))))
    (if (i32.ge_u (local.get $assignment) (i32.const 16384))
      (then (local.set $n (i32.const 24))
        (local.set $value (i32.or (local.get $assignment) (i32.const 0xC00000)))))
    (if (i32.or (i32.lt_u (local.get $cap) (i32.shr_u (local.get $n) (i32.const 3)))
      (i32.eqz (call $valid_range (local.get $out) (i32.shr_u (local.get $n) (i32.const 3)))))
      (then (return (i32.const -2))))
    (memory.fill (local.get $out) (i32.const 0) (i32.shr_u (local.get $n) (i32.const 3)))
    (call $append (local.get $out) (i32.const 0) (local.get $value) (local.get $n)))

  ;; QR capacities and Reed-Solomon arithmetic in GF(256/0x11D).
  (func $raw_modules (param $ver i32) (result i32) (local $n i32) (local $result i32)
    (local.set $result (i32.add (i32.mul (i32.add (i32.mul (i32.const 16) (local.get $ver))
      (i32.const 128)) (local.get $ver)) (i32.const 64)))
    (if (i32.ge_u (local.get $ver) (i32.const 2)) (then
      (local.set $n (i32.add (i32.div_u (local.get $ver) (i32.const 7)) (i32.const 2)))
      (local.set $result (i32.sub (local.get $result)
        (i32.sub (i32.mul (i32.sub (i32.mul (i32.const 25) (local.get $n)) (i32.const 10))
          (local.get $n)) (i32.const 55))))
      (if (i32.ge_u (local.get $ver) (i32.const 7))
        (then (local.set $result (i32.sub (local.get $result) (i32.const 36)))))))
    (local.get $result))
  (func $data_codewords (param $ver i32) (param $ecl i32) (result i32) (local $index i32)
    (local.set $index (i32.add (i32.mul (local.get $ecl) (i32.const 41)) (local.get $ver)))
    (i32.sub (i32.div_u (call $raw_modules (local.get $ver)) (i32.const 8))
      (i32.mul (i32.load8_u (local.get $index)) (i32.load8_u offset=164 (local.get $index)))))
  (func $multiply (param $x i32) (param $y i32) (result i32) (local $z i32) (local $i i32)
    (local.set $i (i32.const 8))
    (loop $bits
      (local.set $i (i32.sub (local.get $i) (i32.const 1)))
      (local.set $z (i32.xor (i32.shl (local.get $z) (i32.const 1))
        (i32.mul (i32.shr_u (local.get $z) (i32.const 7)) (i32.const 0x11D))))
      (local.set $z (i32.xor (local.get $z)
        (i32.mul (call $bit (local.get $y) (local.get $i)) (local.get $x))))
      (br_if $bits (local.get $i)))
    (local.get $z))
  (func $divisor (param $degree i32) (local $i i32) (local $j i32) (local $root i32) (local $v i32)
    (memory.fill (i32.const 73728) (i32.const 0) (local.get $degree))
    (i32.store8 (i32.add (i32.const 73727) (local.get $degree)) (i32.const 1))
    (local.set $root (i32.const 1))
    (loop $roots
      (local.set $j (i32.const 0))
      (loop $coefficients
        (local.set $v (call $multiply (i32.load8_u offset=73728 (local.get $j)) (local.get $root)))
        (if (i32.lt_u (i32.add (local.get $j) (i32.const 1)) (local.get $degree))
          (then (local.set $v (i32.xor (local.get $v) (i32.load8_u offset=73729 (local.get $j))))))
        (i32.store8 offset=73728 (local.get $j) (local.get $v))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br_if $coefficients (i32.lt_u (local.get $j) (local.get $degree))))
      (local.set $root (call $multiply (local.get $root) (i32.const 2)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $roots (i32.lt_u (local.get $i) (local.get $degree)))))
  (func $remainder (param $ptr i32) (param $len i32) (param $degree i32)
    (local $i i32) (local $j i32) (local $factor i32)
    (memory.fill (i32.const 73760) (i32.const 0) (local.get $degree))
    (block $done (loop $bytes
      (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
      (local.set $factor (i32.xor (i32.load8_u (i32.add (local.get $ptr) (local.get $i)))
        (i32.load8_u (i32.const 73760))))
      (memory.copy (i32.const 73760) (i32.const 73761) (i32.sub (local.get $degree) (i32.const 1)))
      (i32.store8 (i32.add (i32.const 73759) (local.get $degree)) (i32.const 0))
      (local.set $j (i32.const 0))
      (loop $coefficients
        (i32.store8 offset=73760 (local.get $j)
          (i32.xor (i32.load8_u offset=73760 (local.get $j))
            (call $multiply (i32.load8_u offset=73728 (local.get $j)) (local.get $factor))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br_if $coefficients (i32.lt_u (local.get $j) (local.get $degree))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $bytes))))
  (func $interleave (local $blocks i32) (local $degree i32) (local $raw i32)
    (local $data_len i32) (local $short_blocks i32) (local $short_len i32)
    (local $i i32) (local $j i32) (local $k i32) (local $len i32) (local $ptr i32) (local $index i32)
    (local.set $index (i32.add (i32.mul (global.get $ecl) (i32.const 41)) (global.get $version)))
    (local.set $blocks (i32.load8_u offset=164 (local.get $index)))
    (local.set $degree (i32.load8_u (local.get $index)))
    (local.set $raw (i32.div_u (call $raw_modules (global.get $version)) (i32.const 8)))
    (local.set $data_len (call $data_codewords (global.get $version) (global.get $ecl)))
    (local.set $short_blocks (i32.sub (local.get $blocks) (i32.rem_u (local.get $raw) (local.get $blocks))))
    (local.set $short_len (i32.sub (i32.div_u (local.get $raw) (local.get $blocks)) (local.get $degree)))
    (call $divisor (local.get $degree))
    (local.set $ptr (i32.const 65536))
    (loop $blocks_loop
      (local.set $len (i32.add (local.get $short_len) (i32.ge_u (local.get $i) (local.get $short_blocks))))
      (call $remainder (local.get $ptr) (local.get $len) (local.get $degree))
      (local.set $j (i32.const 0)) (local.set $k (local.get $i))
      (block $data_done (loop $data
        (br_if $data_done (i32.ge_u (local.get $j) (local.get $len)))
        (if (i32.eq (local.get $j) (local.get $short_len))
          (then (local.set $k (i32.sub (local.get $k) (local.get $short_blocks)))))
        (i32.store8 offset=69632 (local.get $k) (i32.load8_u (i32.add (local.get $ptr) (local.get $j))))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (local.set $k (i32.add (local.get $k) (local.get $blocks)))
        (br $data)))
      (local.set $j (i32.const 0)) (local.set $k (i32.add (local.get $data_len) (local.get $i)))
      (loop $ecc
        (i32.store8 offset=69632 (local.get $k) (i32.load8_u offset=73760 (local.get $j)))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (local.set $k (i32.add (local.get $k) (local.get $blocks)))
        (br_if $ecc (i32.lt_u (local.get $j) (local.get $degree))))
      (local.set $ptr (i32.add (local.get $ptr) (local.get $len)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $blocks_loop (i32.lt_u (local.get $i) (local.get $blocks)))))
  ;; Drawing uses one byte per module (0 or 1), with a parallel function map.
  (func $set_function (param $x i32) (param $y i32) (param $color i32) (local $index i32)
    (local.set $index (i32.add (i32.mul (local.get $y) (global.get $size)) (local.get $x)))
    (i32.store8 offset=1024 (local.get $index) (local.get $color))
    (i32.store8 offset=32768 (local.get $index) (i32.const 1)))
  (func $draw_pattern (param $x i32) (param $y i32) (param $radius i32)
    (local $dx i32) (local $dy i32) (local $xx i32) (local $yy i32) (local $dist i32)
    ;; radius=4: finder with separator; radius=2: alignment pattern.
    (local.set $dy (i32.sub (i32.const 0) (local.get $radius)))
    (loop $rows
      (local.set $dx (i32.sub (i32.const 0) (local.get $radius)))
      (loop $columns
        (local.set $xx (i32.add (local.get $x) (local.get $dx)))
        (local.set $yy (i32.add (local.get $y) (local.get $dy)))
        (if (i32.and (i32.lt_u (local.get $xx) (global.get $size))
                     (i32.lt_u (local.get $yy) (global.get $size))) (then
          (local.set $dist (select (call $abs (local.get $dx)) (call $abs (local.get $dy))
            (i32.gt_u (call $abs (local.get $dx)) (call $abs (local.get $dy)))))
          (call $set_function (local.get $xx) (local.get $yy)
            (select (i32.and (i32.ne (local.get $dist) (i32.const 2)) (i32.ne (local.get $dist) (i32.const 4)))
              (i32.ne (local.get $dist) (i32.const 1)) (i32.eq (local.get $radius) (i32.const 4))))))
        (local.set $dx (i32.add (local.get $dx) (i32.const 1)))
        (br_if $columns (i32.le_s (local.get $dx) (local.get $radius))))
      (local.set $dy (i32.add (local.get $dy) (i32.const 1)))
      (br_if $rows (i32.le_s (local.get $dy) (local.get $radius)))))
  (func $draw_format (param $mask i32) (local $data i32) (local $rem i32) (local $bits i32) (local $i i32)
    ;; ECC ordinals 0,1,2,3 map to format bits 1,0,3,2.
    (local.set $data (i32.or (i32.shl (i32.xor (global.get $ecl) (i32.const 1)) (i32.const 3)) (local.get $mask)))
    (local.set $rem (local.get $data))
    (loop $bch
      (local.set $rem (i32.xor (i32.shl (local.get $rem) (i32.const 1))
        (i32.mul (i32.shr_u (local.get $rem) (i32.const 9)) (i32.const 0x537))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $bch (i32.lt_u (local.get $i) (i32.const 10))))
    (local.set $bits (i32.xor (i32.or (i32.shl (local.get $data) (i32.const 10)) (local.get $rem)) (i32.const 0x5412)))
    (local.set $i (i32.const 0))
    (loop $first
      (call $set_function (i32.const 8) (local.get $i) (call $bit (local.get $bits) (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $first (i32.lt_u (local.get $i) (i32.const 6))))
    (call $set_function (i32.const 8) (i32.const 7) (call $bit (local.get $bits) (i32.const 6)))
    (call $set_function (i32.const 8) (i32.const 8) (call $bit (local.get $bits) (i32.const 7)))
    (call $set_function (i32.const 7) (i32.const 8) (call $bit (local.get $bits) (i32.const 8)))
    (local.set $i (i32.const 9))
    (loop $first_rest
      (call $set_function (i32.sub (i32.const 14) (local.get $i)) (i32.const 8) (call $bit (local.get $bits) (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $first_rest (i32.lt_u (local.get $i) (i32.const 15))))
    (local.set $i (i32.const 0))
    (loop $second
      (call $set_function (i32.sub (i32.sub (global.get $size) (i32.const 1)) (local.get $i))
        (i32.const 8) (call $bit (local.get $bits) (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $second (i32.lt_u (local.get $i) (i32.const 8))))
    (loop $second_rest
      (call $set_function (i32.const 8) (i32.add (i32.sub (global.get $size) (i32.const 15)) (local.get $i))
        (call $bit (local.get $bits) (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $second_rest (i32.lt_u (local.get $i) (i32.const 15))))
    (call $set_function (i32.const 8) (i32.sub (global.get $size) (i32.const 8)) (i32.const 1)))
  (func $draw_functions (local $i i32) (local $j i32) (local $n i32) (local $step i32)
    (local $pos i32) (local $rem i32) (local $bits i32) (local $a i32) (local $b i32)
    (memory.fill (i32.const 1024) (i32.const 0) (i32.mul (global.get $size) (global.get $size)))
    (memory.fill (i32.const 32768) (i32.const 0) (i32.mul (global.get $size) (global.get $size)))
    (loop $timing
      (call $set_function (i32.const 6) (local.get $i) (i32.eqz (i32.and (local.get $i) (i32.const 1))))
      (call $set_function (local.get $i) (i32.const 6) (i32.eqz (i32.and (local.get $i) (i32.const 1))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $timing (i32.lt_u (local.get $i) (global.get $size))))
    (call $draw_pattern (i32.const 3) (i32.const 3) (i32.const 4))
    (call $draw_pattern (i32.sub (global.get $size) (i32.const 4)) (i32.const 3) (i32.const 4))
    (call $draw_pattern (i32.const 3) (i32.sub (global.get $size) (i32.const 4)) (i32.const 4))
    (if (i32.ge_u (global.get $version) (i32.const 2)) (then
      (local.set $n (i32.add (i32.div_u (global.get $version) (i32.const 7)) (i32.const 2)))
      (local.set $step (i32.mul (i32.div_u
        (i32.add (i32.add (i32.mul (global.get $version) (i32.const 8)) (i32.mul (local.get $n) (i32.const 3))) (i32.const 5))
        (i32.sub (i32.mul (local.get $n) (i32.const 4)) (i32.const 4))) (i32.const 2)))
      (i32.store (i32.const 73840) (i32.const 6))
      (local.set $i (i32.sub (local.get $n) (i32.const 1)))
      (local.set $pos (i32.sub (global.get $size) (i32.const 7)))
      (loop $positions
        (i32.store (i32.add (i32.const 73840) (i32.mul (local.get $i) (i32.const 4))) (local.get $pos))
        (local.set $pos (i32.sub (local.get $pos) (local.get $step)))
        (local.set $i (i32.sub (local.get $i) (i32.const 1)))
        (br_if $positions (local.get $i)))
      (local.set $i (i32.const 0))
      (loop $align_rows
        (local.set $j (i32.const 0))
        (loop $align_columns
          ;; Omit the three finder corners.
          (if (i32.eqz (i32.or
            (i32.and (i32.eqz (local.get $i))
              (i32.or (i32.eqz (local.get $j)) (i32.eq (local.get $j) (i32.sub (local.get $n) (i32.const 1)))))
            (i32.and (i32.eq (local.get $i) (i32.sub (local.get $n) (i32.const 1))) (i32.eqz (local.get $j)))))
            (then (call $draw_pattern
              (i32.load (i32.add (i32.const 73840) (i32.mul (local.get $i) (i32.const 4))))
              (i32.load (i32.add (i32.const 73840) (i32.mul (local.get $j) (i32.const 4)))) (i32.const 2))))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (br_if $align_columns (i32.lt_u (local.get $j) (local.get $n))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $align_rows (i32.lt_u (local.get $i) (local.get $n))))))
    (call $draw_format (i32.const 0))
    (if (i32.ge_u (global.get $version) (i32.const 7)) (then
      (local.set $rem (global.get $version)) (local.set $i (i32.const 0))
      (loop $bch
        (local.set $rem (i32.xor (i32.shl (local.get $rem) (i32.const 1))
          (i32.mul (i32.shr_u (local.get $rem) (i32.const 11)) (i32.const 0x1F25))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $bch (i32.lt_u (local.get $i) (i32.const 12))))
      (local.set $bits (i32.or (i32.shl (global.get $version) (i32.const 12)) (local.get $rem)))
      (local.set $i (i32.const 0))
      (loop $version_bits
        (local.set $a (i32.add (i32.sub (global.get $size) (i32.const 11)) (i32.rem_u (local.get $i) (i32.const 3))))
        (local.set $b (i32.div_u (local.get $i) (i32.const 3)))
        (call $set_function (local.get $a) (local.get $b) (call $bit (local.get $bits) (local.get $i)))
        (call $set_function (local.get $b) (local.get $a) (call $bit (local.get $bits) (local.get $i)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $version_bits (i32.lt_u (local.get $i) (i32.const 18)))))))
  (func $draw_codewords (local $right i32) (local $vert i32) (local $j i32)
    (local $x i32) (local $y i32) (local $index i32) (local $i i32) (local $limit i32)
    (local.set $limit (i32.and (call $raw_modules (global.get $version)) (i32.const -8)))
    (local.set $right (i32.sub (global.get $size) (i32.const 1)))
    (loop $pairs
      (if (i32.eq (local.get $right) (i32.const 6)) (then (local.set $right (i32.const 5))))
      (local.set $vert (i32.const 0))
      (loop $vertical
        (local.set $j (i32.const 0))
        (local.set $y (select (i32.sub (i32.sub (global.get $size) (i32.const 1)) (local.get $vert))
          (local.get $vert) (i32.eqz (i32.and (i32.add (local.get $right) (i32.const 1)) (i32.const 2)))))
        (loop $columns
          (local.set $x (i32.sub (local.get $right) (local.get $j)))
          (local.set $index (i32.add (i32.mul (local.get $y) (global.get $size)) (local.get $x)))
          (if (i32.and (i32.eqz (i32.load8_u offset=32768 (local.get $index))) (i32.lt_u (local.get $i) (local.get $limit)))
            (then
              (i32.store8 offset=1024 (local.get $index)
                (call $bit (i32.load8_u offset=69632 (i32.shr_u (local.get $i) (i32.const 3)))
                  (i32.sub (i32.const 7) (i32.and (local.get $i) (i32.const 7)))))
              (local.set $i (i32.add (local.get $i) (i32.const 1)))))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (br_if $columns (i32.lt_u (local.get $j) (i32.const 2))))
        (local.set $vert (i32.add (local.get $vert) (i32.const 1)))
        (br_if $vertical (i32.lt_u (local.get $vert) (global.get $size))))
      (local.set $right (i32.sub (local.get $right) (i32.const 2)))
      (br_if $pairs (i32.ge_s (local.get $right) (i32.const 1)))))
  (func $mask_bit (param $mask i32) (param $x i32) (param $y i32) (result i32) (local $p i32)
    (if (i32.eqz (local.get $mask))
      (then (return (i32.eqz (i32.and (i32.add (local.get $x) (local.get $y)) (i32.const 1))))))
    (if (i32.eq (local.get $mask) (i32.const 1))
      (then (return (i32.eqz (i32.and (local.get $y) (i32.const 1))))))
    (if (i32.eq (local.get $mask) (i32.const 2))
      (then (return (i32.eqz (i32.rem_u (local.get $x) (i32.const 3))))))
    (if (i32.eq (local.get $mask) (i32.const 3))
      (then (return (i32.eqz (i32.rem_u (i32.add (local.get $x) (local.get $y)) (i32.const 3))))))
    (if (i32.eq (local.get $mask) (i32.const 4))
      (then (return (i32.eqz (i32.and (i32.add (i32.div_u (local.get $x) (i32.const 3))
        (i32.div_u (local.get $y) (i32.const 2))) (i32.const 1))))))
    (local.set $p (i32.mul (local.get $x) (local.get $y)))
    (if (i32.eq (local.get $mask) (i32.const 5))
      (then (return (i32.eqz (i32.add (i32.and (local.get $p) (i32.const 1)) (i32.rem_u (local.get $p) (i32.const 3)))))))
    (if (i32.eq (local.get $mask) (i32.const 6))
      (then (return (i32.eqz (i32.and (i32.add (i32.and (local.get $p) (i32.const 1))
        (i32.rem_u (local.get $p) (i32.const 3))) (i32.const 1))))))
    (i32.eqz (i32.and (i32.add (i32.and (i32.add (local.get $x) (local.get $y)) (i32.const 1))
      (i32.rem_u (local.get $p) (i32.const 3))) (i32.const 1))))
  (func $apply_mask (param $mask i32) (local $x i32) (local $y i32) (local $index i32)
    (loop $rows
      (local.set $x (i32.const 0))
      (loop $columns
        (if (i32.eqz (i32.load8_u offset=32768 (local.get $index)))
          (then (i32.store8 offset=1024 (local.get $index)
            (i32.xor (i32.load8_u offset=1024 (local.get $index))
              (call $mask_bit (local.get $mask) (local.get $x) (local.get $y))))))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $columns (i32.lt_u (local.get $x) (global.get $size))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $rows (i32.lt_u (local.get $y) (global.get $size)))))

  ;; Penalty scoring includes scaled 1:1:3:1:1 patterns and the virtual white border.
  (func $history_add (param $len i32)
    (if (i32.eqz (i32.load (i32.const 73800)))
      (then (local.set $len (i32.add (local.get $len) (global.get $size)))))
    (memory.copy (i32.const 73804) (i32.const 73800) (i32.const 24))
    (i32.store (i32.const 73800) (local.get $len)))
  (func $history_count (result i32) (local $n i32) (local $first i32) (local $last i32)
    (local.set $n (i32.load (i32.const 73804)))
    (if (i32.eqz (local.get $n)) (then (return (i32.const 0))))
    (if (i32.or (i32.or (i32.ne (i32.load (i32.const 73808)) (local.get $n))
                         (i32.ne (i32.load (i32.const 73812)) (i32.mul (local.get $n) (i32.const 3))))
                 (i32.or (i32.ne (i32.load (i32.const 73816)) (local.get $n))
                         (i32.ne (i32.load (i32.const 73820)) (local.get $n))))
      (then (return (i32.const 0))))
    (local.set $first (i32.load (i32.const 73800))) (local.set $last (i32.load (i32.const 73824)))
    (i32.add (i32.and (i32.ge_u (local.get $first) (i32.mul (local.get $n) (i32.const 4)))
                     (i32.ge_u (local.get $last) (local.get $n)))
             (i32.and (i32.ge_u (local.get $last) (i32.mul (local.get $n) (i32.const 4)))
                     (i32.ge_u (local.get $first) (local.get $n)))))
  (func $penalty_line (param $start i32) (param $stride i32) (result i32)
    (local $i i32) (local $color i32) (local $run i32) (local $current i32) (local $score i32)
    (memory.fill (i32.const 73800) (i32.const 0) (i32.const 28))
    (loop $cells
      (local.set $current (i32.load8_u offset=1024 (local.get $start)))
      (if (i32.eq (local.get $current) (local.get $color))
        (then
          (local.set $run (i32.add (local.get $run) (i32.const 1)))
          (if (i32.eq (local.get $run) (i32.const 5))
            (then (local.set $score (i32.add (local.get $score) (i32.const 3))))
            (else (if (i32.gt_u (local.get $run) (i32.const 5))
              (then (local.set $score (i32.add (local.get $score) (i32.const 1))))))))
        (else
          (call $history_add (local.get $run))
          (if (i32.eqz (local.get $color))
            (then (local.set $score (i32.add (local.get $score) (i32.mul (call $history_count) (i32.const 40))))))
          (local.set $color (local.get $current)) (local.set $run (i32.const 1))))
      (local.set $start (i32.add (local.get $start) (local.get $stride)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $cells (i32.lt_u (local.get $i) (global.get $size))))
    (if (local.get $color) (then (call $history_add (local.get $run)) (local.set $run (i32.const 0))))
    (call $history_add (i32.add (local.get $run) (global.get $size)))
    (i32.add (local.get $score) (i32.mul (call $history_count) (i32.const 40))))
  (func $penalty (result i32) (local $score i32) (local $i i32) (local $x i32)
    (local $y i32) (local $index i32) (local $color i32) (local $dark i32) (local $total i32) (local $balance i32)
    (loop $lines
      (local.set $score (i32.add (local.get $score)
        (i32.add (call $penalty_line (i32.mul (local.get $i) (global.get $size)) (i32.const 1))
                 (call $penalty_line (local.get $i) (global.get $size)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $lines (i32.lt_u (local.get $i) (global.get $size))))
    (loop $rows
      (local.set $x (i32.const 0))
      (loop $columns
        (local.set $index (i32.add (i32.mul (local.get $y) (global.get $size)) (local.get $x)))
        (local.set $color (i32.load8_u offset=1024 (local.get $index)))
        (if (i32.and (i32.eq (local.get $color) (i32.load8_u offset=1025 (local.get $index)))
          (i32.and (i32.eq (local.get $color) (i32.load8_u offset=1024 (i32.add (local.get $index) (global.get $size))))
                   (i32.eq (local.get $color) (i32.load8_u offset=1025 (i32.add (local.get $index) (global.get $size))))))
          (then (local.set $score (i32.add (local.get $score) (i32.const 3)))))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $columns (i32.lt_u (local.get $x) (i32.sub (global.get $size) (i32.const 1)))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $rows (i32.lt_u (local.get $y) (i32.sub (global.get $size) (i32.const 1)))))
    (local.set $total (i32.mul (global.get $size) (global.get $size))) (local.set $i (i32.const 0))
    (loop $count_dark
      (local.set $dark (i32.add (local.get $dark) (i32.load8_u offset=1024 (local.get $i))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $count_dark (i32.lt_u (local.get $i) (local.get $total))))
    ;; ceil(abs(dark*20-total*10)/total)-1, with odd total so numerator > 0.
    (local.set $balance (i32.div_u (i32.sub (call $abs (i32.sub
      (i32.mul (local.get $dark) (i32.const 20)) (i32.mul (local.get $total) (i32.const 10)))) (i32.const 1)) (local.get $total)))
    (i32.add (local.get $score) (i32.mul (local.get $balance) (i32.const 10))))
  ;; Public encoding entry points return symbol size (21..177), -1 if data does
  ;; not fit, or -2 for invalid arguments. No valid call requires host imports.
  (func $valid_options (param $ecl i32) (param $min i32) (param $max i32) (param $mask i32) (param $boost i32)
    (result i32)
    (i32.and (i32.and (i32.le_u (local.get $ecl) (i32.const 3))
      (i32.and (i32.ge_u (local.get $min) (i32.const 1)) (i32.le_u (local.get $max) (i32.const 40))))
      (i32.and (i32.and (i32.le_u (local.get $min) (local.get $max)) (i32.le_u (local.get $boost) (i32.const 1)))
        (i32.and (i32.ge_s (local.get $mask) (i32.const -1)) (i32.le_s (local.get $mask) (i32.const 7))))))
  (func $total_bits (param $segs i32) (param $count i32) (param $ver i32) (result i32)
    (local $i i32) (local $seg i32) (local $n i32) (local $cc i32) (local $total i32)
    (block $done (loop $segments
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $seg (i32.add (local.get $segs) (i32.mul (local.get $i) (i32.const 16))))
      (local.set $n (i32.load offset=4 (local.get $seg)))
      (local.set $cc (call $count_bits (i32.load (local.get $seg)) (local.get $ver)))
      (if (i32.ge_u (local.get $n) (i32.shl (i32.const 1) (local.get $cc)))
        (then (return (i32.const -1))))
      (local.set $total (i32.add (local.get $total)
        (i32.add (i32.add (i32.const 4) (local.get $cc)) (i32.load offset=12 (local.get $seg)))))
      (if (i32.gt_u (local.get $total) (i32.const 32767)) (then (return (i32.const -1))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $segments)))
    (local.get $total))
  (func $encode (param $segs i32) (param $count i32) (param $ecl i32)
    (param $min i32) (param $max i32) (param $mask i32) (param $boost i32) (result i32)
    (local $ver i32) (local $used i32) (local $capacity i32) (local $candidate i32)
    (local $i i32) (local $j i32) (local $seg i32) (local $bits i32) (local $pos i32)
    (local $pad i32)
    (local.set $ver (local.get $min))
    (block $found (loop $versions
      (local.set $used (call $total_bits (local.get $segs) (local.get $count) (local.get $ver)))
      (local.set $capacity (i32.mul (call $data_codewords (local.get $ver) (local.get $ecl)) (i32.const 8)))
      (br_if $found (i32.and (i32.ge_s (local.get $used) (i32.const 0)) (i32.le_u (local.get $used) (local.get $capacity))))
      (if (i32.ge_u (local.get $ver) (local.get $max)) (then (return (i32.const -1))))
      (local.set $ver (i32.add (local.get $ver) (i32.const 1)))
      (br $versions)))
    (global.set $version (local.get $ver))
    (global.set $size (i32.add (i32.mul (local.get $ver) (i32.const 4)) (i32.const 17)))
    (if (local.get $boost) (then
      (local.set $candidate (i32.add (local.get $ecl) (i32.const 1)))
      (block $boost_done (loop $levels
        (br_if $boost_done (i32.gt_u (local.get $candidate) (i32.const 3)))
        (if (i32.le_u (local.get $used) (i32.mul (call $data_codewords (local.get $ver) (local.get $candidate)) (i32.const 8)))
          (then (local.set $ecl (local.get $candidate))))
        (local.set $candidate (i32.add (local.get $candidate) (i32.const 1)))
        (br $levels)))))
    (global.set $ecl (local.get $ecl))
    (local.set $capacity (i32.mul (call $data_codewords (local.get $ver) (local.get $ecl)) (i32.const 8)))
    (memory.fill (i32.const 65536) (i32.const 0) (i32.const 4096))
    (block $segments_done (loop $segments
      (br_if $segments_done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $seg (i32.add (local.get $segs) (i32.mul (local.get $i) (i32.const 16))))
      (local.set $pos (call $append (i32.const 65536) (local.get $pos) (i32.load (local.get $seg)) (i32.const 4)))
      (local.set $pos (call $append (i32.const 65536) (local.get $pos) (i32.load offset=4 (local.get $seg))
        (call $count_bits (i32.load (local.get $seg)) (local.get $ver))))
      (local.set $j (i32.const 0))
      (block $bits_done (loop $copy_bits
        (br_if $bits_done (i32.ge_u (local.get $j) (i32.load offset=12 (local.get $seg))))
        (local.set $bits (call $bit (i32.load8_u
          (i32.add (i32.load offset=8 (local.get $seg)) (i32.shr_u (local.get $j) (i32.const 3))))
          (i32.sub (i32.const 7) (i32.and (local.get $j) (i32.const 7)))))
        (local.set $pos (call $append (i32.const 65536) (local.get $pos) (local.get $bits) (i32.const 1)))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $copy_bits)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $segments)))
    (local.set $bits (i32.sub (local.get $capacity) (local.get $pos)))
    (local.set $pos (call $append (i32.const 65536) (local.get $pos) (i32.const 0)
      (select (local.get $bits) (i32.const 4) (i32.lt_u (local.get $bits) (i32.const 4)))))
    (local.set $pos (call $append (i32.const 65536) (local.get $pos) (i32.const 0)
      (i32.and (i32.sub (i32.const 0) (local.get $pos)) (i32.const 7))))
    (local.set $pad (i32.const 236))
    (block $padding_done (loop $padding
      (br_if $padding_done (i32.ge_u (local.get $pos) (local.get $capacity)))
      (local.set $pos (call $append (i32.const 65536) (local.get $pos) (local.get $pad) (i32.const 8)))
      (local.set $pad (i32.xor (local.get $pad) (i32.const 253)))
      (br $padding)))
    (call $draw_symbol (local.get $mask)))

  ;; Shared low-level construction from the padded data bytes at 65536.
  ;; Version, size, and ECC have already been validated and set by the caller.
  (func $draw_symbol (param $mask i32) (result i32)
    (local $i i32) (local $score i32) (local $best i32)
    (call $interleave)
    (call $draw_functions)
    (call $draw_codewords)
    (if (i32.eq (local.get $mask) (i32.const -1)) (then
      (local.set $best (i32.const 2147483647)) (local.set $i (i32.const 0))
      (loop $masks
        (call $apply_mask (local.get $i)) (call $draw_format (local.get $i))
        (local.set $score (call $penalty))
        (if (i32.lt_u (local.get $score) (local.get $best))
          (then (local.set $mask (local.get $i)) (local.set $best (local.get $score))))
        (call $apply_mask (local.get $i))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $masks (i32.lt_u (local.get $i) (i32.const 8))))))
    (global.set $mask (local.get $mask))
    (call $apply_mask (local.get $mask)) (call $draw_format (local.get $mask))
    (global.get $size))

  ;; Low-level API equivalent to the upstream QrCode constructor. The caller
  ;; supplies exactly the data capacity in bytes, including segment headers,
  ;; terminator, and padding, but excluding ECC codewords. No version selection,
  ;; ECC boosting, or payload validation is performed. Input is not modified.
  ;; Return -2 for an invalid memory range, option, or codeword count.
  (func (export "encode_codewords") (param $ptr i32) (param $len i32)
    (param $ver i32) (param $ecl i32) (param $mask i32) (result i32)
    (call $reset)
    (if (i32.or (i32.eqz (call $valid_range (local.get $ptr) (local.get $len)))
      (i32.eqz (call $valid_options (local.get $ecl) (local.get $ver) (local.get $ver)
        (local.get $mask) (i32.const 0))))
      (then (return (i32.const -2))))
    (if (i32.ne (local.get $len) (call $data_codewords (local.get $ver) (local.get $ecl)))
      (then (return (i32.const -2))))
    (memory.copy (i32.const 65536) (local.get $ptr) (local.get $len))
    (global.set $version (local.get $ver))
    (global.set $size (i32.add (i32.mul (local.get $ver) (i32.const 4)) (i32.const 17)))
    (global.set $ecl (local.get $ecl))
    (call $draw_symbol (local.get $mask)))

  ;; Descriptor layout: mode, character count, data pointer, bit length; four
  ;; little-endian i32 fields. Data bits are packed MSB first, unlike module bytes.
  (func (export "encode_segments") (param $segs i32) (param $count i32) (param $ecl i32)
    (param $min i32) (param $max i32) (param $mask i32) (param $boost i32) (result i32)
    (local $i i32) (local $seg i32) (local $mode i32) (local $n i32) (local $bits i32)
    (local $ptr i32) (local $head i32) (local $assignment i32)
    (call $reset)
    (if (i32.eqz (call $valid_options (local.get $ecl) (local.get $min) (local.get $max) (local.get $mask) (local.get $boost)))
      (then (return (i32.const -2))))
    (if (i32.gt_u (local.get $count) (i32.const 24576)) (then (return (i32.const -2))))
    (if (i32.eqz (call $valid_range (local.get $segs) (i32.mul (local.get $count) (i32.const 16))))
      (then (return (i32.const -2))))
    (block $done (loop $validate
      (br_if $done (i32.ge_u (local.get $i) (local.get $count)))
      (local.set $seg (i32.add (local.get $segs) (i32.mul (local.get $i) (i32.const 16))))
      (local.set $mode (i32.load (local.get $seg))) (local.set $n (i32.load offset=4 (local.get $seg)))
      (local.set $ptr (i32.load offset=8 (local.get $seg))) (local.set $bits (i32.load offset=12 (local.get $seg)))
      (if (i32.or (i32.gt_u (local.get $n) (i32.const 32767)) (i32.gt_u (local.get $bits) (i32.const 32767)))
        (then (return (i32.const -2))))
      (if (i32.eqz (call $valid_range (local.get $ptr) (i32.shr_u (i32.add (local.get $bits) (i32.const 7)) (i32.const 3))))
        (then (return (i32.const -2))))
      (if (i32.eq (local.get $mode) (i32.const 7))
        (then
          (if (local.get $n) (then (return (i32.const -2))))
          (if (i32.eqz (i32.or (i32.eq (local.get $bits) (i32.const 8))
            (i32.or (i32.eq (local.get $bits) (i32.const 16)) (i32.eq (local.get $bits) (i32.const 24)))))
            (then (return (i32.const -2))))
          (local.set $head (i32.load8_u (local.get $ptr)))
          (if (i32.eq (local.get $bits) (i32.const 8))
            (then (if (i32.ge_u (local.get $head) (i32.const 128)) (then (return (i32.const -2))))))
          (if (i32.eq (local.get $bits) (i32.const 16))
            (then (if (i32.ne (i32.and (local.get $head) (i32.const 192)) (i32.const 128))
              (then (return (i32.const -2))))))
          (if (i32.eq (local.get $bits) (i32.const 24)) (then
            (if (i32.ne (i32.and (local.get $head) (i32.const 224)) (i32.const 192))
              (then (return (i32.const -2))))
            (local.set $assignment (i32.or (i32.shl (i32.and (local.get $head) (i32.const 31)) (i32.const 16))
              (i32.or (i32.shl (i32.load8_u offset=1 (local.get $ptr)) (i32.const 8)) (i32.load8_u offset=2 (local.get $ptr)))))
            (if (i32.ge_u (local.get $assignment) (i32.const 1000000)) (then (return (i32.const -2)))))))
        (else
          (if (i32.ne (call $segment_bits (local.get $mode) (local.get $n)) (local.get $bits))
            (then (return (i32.const -2))))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $validate)))
    (call $encode (local.get $segs) (local.get $count) (local.get $ecl)
      (local.get $min) (local.get $max) (local.get $mask) (local.get $boost)))
  (func (export "encode_binary") (param $ptr i32) (param $len i32) (param $ecl i32)
    (param $min i32) (param $max i32) (param $mask i32) (param $boost i32) (result i32)
    (call $reset)
    (if (i32.or (i32.eqz (call $valid_range (local.get $ptr) (local.get $len)))
      (i32.eqz (call $valid_options (local.get $ecl) (local.get $min) (local.get $max) (local.get $mask) (local.get $boost))))
      (then (return (i32.const -2))))
    (if (i32.gt_u (local.get $len) (i32.const 2953)) (then (return (i32.const -1))))
    (i32.store (i32.const 73872) (i32.const 4))
    (i32.store (i32.const 73876) (local.get $len))
    (i32.store (i32.const 73880) (local.get $ptr))
    (i32.store (i32.const 73884) (i32.mul (local.get $len) (i32.const 8)))
    (call $encode (i32.const 73872) (i32.const 1) (local.get $ecl)
      (local.get $min) (local.get $max) (local.get $mask) (local.get $boost)))
  (func (export "encode_text") (param $ptr i32) (param $len i32) (param $ecl i32)
    (param $min i32) (param $max i32) (param $mask i32) (param $boost i32) (result i32)
    (local $i i32) (local $c i32) (local $numeric i32) (local $alpha i32) (local $mode i32) (local $bits i32)
    (call $reset)
    (if (i32.or (i32.eqz (call $valid_range (local.get $ptr) (local.get $len)))
      (i32.eqz (call $valid_options (local.get $ecl) (local.get $min) (local.get $max) (local.get $mask) (local.get $boost))))
      (then (return (i32.const -2))))
    (if (i32.gt_u (local.get $len) (i32.const 7089)) (then (return (i32.const -1))))
    (if (i32.eqz (local.get $len))
      (then (return (call $encode (i32.const 0) (i32.const 0) (local.get $ecl)
        (local.get $min) (local.get $max) (local.get $mask) (local.get $boost)))))
    (local.set $numeric (i32.const 1)) (local.set $alpha (i32.const 1))
    (loop $scan
      (local.set $c (i32.load8_u (i32.add (local.get $ptr) (local.get $i))))
      (if (i32.gt_u (i32.sub (local.get $c) (i32.const 48)) (i32.const 9))
        (then (local.set $numeric (i32.const 0))))
      (if (i32.lt_s (call $alpha_value (local.get $c)) (i32.const 0))
        (then (local.set $alpha (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $scan (i32.lt_u (local.get $i) (local.get $len))))
    (local.set $mode (select (i32.const 1) (select (i32.const 2) (i32.const 4) (local.get $alpha)) (local.get $numeric)))
    (local.set $bits (call $segment_bits (local.get $mode) (local.get $len)))
    (if (i32.or (i32.lt_s (local.get $bits) (i32.const 0)) (i32.gt_u (local.get $bits) (i32.const 32767)))
      (then (return (i32.const -1))))
    (drop (call $make_segment_internal (local.get $mode) (local.get $ptr) (local.get $len) (i32.const 77824)))
    (i32.store (i32.const 73872) (local.get $mode)) (i32.store (i32.const 73876) (local.get $len))
    (i32.store (i32.const 73880) (i32.const 77824)) (i32.store (i32.const 73884) (local.get $bits))
    (call $encode (i32.const 73872) (i32.const 1) (local.get $ecl)
      (local.get $min) (local.get $max) (local.get $mask) (local.get $boost)))
)
